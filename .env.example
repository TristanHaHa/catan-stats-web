# Public web app configuration, NOT Admin SDK credentials. Never put server keys in VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional reCAPTCHA v3 site key for Firestore App Check. No paid provider is required.
VITE_FIREBASE_APP_CHECK_KEY=
# Local testing only; never enable this on the public GitHub Pages build.
VITE_FIREBASE_EMULATORS=false
